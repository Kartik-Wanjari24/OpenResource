# OpenResource Environment Configuration
PORT=3000
NODE_ENV=development

# Storage Configuration
# Set STORAGE_MODE to 'postgres' to use PostgreSQL persistence
# Set STORAGE_MODE to 'memory' (default when DATABASE_URL is unset) for in-memory operation
STORAGE_MODE=memory

# PostgreSQL Connection URL (Required when STORAGE_MODE=postgres)
# Replace placeholder with your real database credentials.
# In production, use managed PostgreSQL with SSL (sslmode=require).
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/openresource_dev

# Authentication & JWT Configuration
# In production (NODE_ENV=production), JWT_SECRET or JWT_PUBLIC_KEY is REQUIRED.
# Must be at least 32 characters long for HMAC-SHA256 (HS256).
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_ISSUER=openresource-auth
JWT_AUDIENCE=openresource-api
JWT_ALGORITHMS=HS256

# Development & Test Authentication
# Set to 'true' in development to enable X-Test-User-* persona headers.
# NOTE: In NODE_ENV=production, test headers are ALWAYS rejected regardless of this setting.
ENABLE_DEV_TEST_AUTH=true

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. https://app.openresource.org)
# Wildcards (*) are strictly rejected in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
