# OpenResource Environment Configuration
PORT=3000
NODE_ENV=development

# Storage Configuration
# Set STORAGE_MODE to 'postgres' to use PostgreSQL persistence
# Set STORAGE_MODE to 'memory' (default when DATABASE_URL is unset) for in-memory operation
STORAGE_MODE=memory

# PostgreSQL Connection URL (Required when STORAGE_MODE=postgres)
# Replace placeholder with your real database credentials.
# In production, use managed PostgreSQL with SSL (sslmode=require).
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/openresource_dev

# Authentication & JWT Configuration
# In production (NODE_ENV=production), JWT_SECRET or JWT_PUBLIC_KEY is REQUIRED.
# Must be at least 32 characters long for HMAC-SHA256 (HS256).
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_ISSUER=openresource-auth
JWT_AUDIENCE=openresource-api
JWT_ALGORITHMS=HS256

# Development & Test Authentication
# Set to 'true' in development to enable X-Test-User-* persona headers.
# NOTE: In NODE_ENV=production, test headers are ALWAYS rejected regardless of this setting.
ENABLE_DEV_TEST_AUTH=true

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. https://app.openresource.org)
# Wildcards (*) are strictly rejected in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Google Gemini Vision API (Required for Phase 1: Condition Inspection)
# Obtain API key from https://aistudio.google.com/apikey
# If unset, /api/trust/inspect-condition will return 503 Service Unavailable
GEMINI_API_KEY=your_gemini_api_key_here

# Phase 2: Eligibility Verification Configuration (Optional)
# JSON configuration for safety assessment and certificate verification
# If unset, verification endpoints return PENDING_MANUAL_REVIEW or CONFIGURATION_REQUIRED
#
# Example configuration:
# ELIGIBILITY_CONFIG={"safetyQuestions":[{"id":"q1","question":"What is the first rule of lab safety?","correctAnswer":"Always wear appropriate PPE","category":"general"},{"id":"q2","question":"What should you do before using equipment?","correctAnswer":"Read the safety manual and complete training","category":"general"},{"id":"q3","question":"Who should you contact in case of an emergency?","correctAnswer":"Lab supervisor or safety officer","category":"emergency"}],"passingThreshold":2,"badgeToAward":"badge_safety_101","trustedCertificateIssuers":[],"certificateVerificationEnabled":false}
ELIGIBILITY_CONFIG=
